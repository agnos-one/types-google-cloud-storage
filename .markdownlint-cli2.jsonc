{
    // Skip files ignored by git
    "gitignore": true,
    // markdownlint rules
    "config": {
        // Keep a Changelog repeats "### Added" etc. under every version
        "no-duplicate-heading": {
            "siblings_only": true
        },
        "table-column-style": {
            "style": "compact"
        },
        "line-length": {
            "line_length": 120,
            "tables": false,
            "code_blocks": false
        }
    }
}

